# Copy to .env for local development. Never commit .env.

# Postgres connection string. Matches docker-compose.yml locally;
# Railway provides its own on deploy (reference the Postgres service's
# DATABASE_URL variable).
DATABASE_URL=postgresql://boardroom:boardroom@localhost:5432/boardroom

# Site-owner admin credential (not a database row). Signs in at /admin.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Secret used to sign session cookies. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Instructor self-service sign-up on the login page:
#   unset / empty  → anyone with the URL can create an instructor login
#   off            → sign-up disabled; the admin creates logins at /admin
#   anything else  → sign-up requires this invite code (recommended on Railway)
REGISTRATION_CODE=

# Port the server listens on. Railway sets this automatically.
PORT=3000

# Set to "production" outside local dev so session cookies are Secure-only.
# Railway deployments are detected automatically (RAILWAY_ENVIRONMENT).
# NODE_ENV=production
