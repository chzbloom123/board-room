  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.10.0",
    "prisma": "^7.8.0"
  },
  "engines": {
    "node": ">=24"
  }
}
