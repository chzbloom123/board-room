# Copy to .env for local development. Never commit .env.

# Postgres connection string. Matches docker-compose.yml locally;
# Railway provides its own on deploy.
DATABASE_URL=postgresql://boardroom:boardroom@localhost:5432/boardroom

# Site-owner admin credential (not a database row).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server listens on. Railway sets this automatically.
PORT=3000
